{
  "realm": "$(env:APP_NAME)",
  "displayName": "$(env:APP_NAME)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en",
    "de",
    "it"
  ],
  "defaultLocale": "fr",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"Nom\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "administrateur",
        "description": "Administrateur de l'application : gestion des comptes (ADR-0005)"
      }
    ]
  },
  "users": [
    {
      "username": "service-account-api-admin",
      "enabled": true,
      "serviceAccountClientId": "api-admin",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users",
          "view-realm"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "web",
      "name": "Application web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "$(env:PUBLIC_URL)/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "$(env:PUBLIC_URL)",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "$(env:PUBLIC_URL)/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mobile",
      "name": "Application mobile",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "$(env:APP_NAME)://*",
        "exp://*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "api-admin",
      "name": "API : Annuaire des comptes (compte de service, ADR-0018)",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:KEYCLOAK_ADMIN_CLIENT_SECRET)",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "defaultClientScopes": ["web-origins", "service_account", "acr", "profile", "roles", "basic", "email", "kc-admin-api"]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "google first broker login",
      "description": "Première connexion Google : crée l'Utilisateur, sans page de profil ; refusée si l'Email ou le Login est déjà pris (ADR-0019, ADR-0024)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-review-profile",
          "requirement": "DISABLED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "idp-create-user-if-unique",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "microsoft first broker login",
      "description": "Première connexion Microsoft : crée le compte, sans page de profil ; refusée si l'Email ou le Login est déjà pris, ou si le compte ne transmet pas d'email (ADR-0024, ADR-0028)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-review-profile",
          "requirement": "DISABLED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "microsoft first broker login - creation",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "microsoft first broker login - sans email",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "microsoft first broker login - creation",
      "description": "Crée le compte si l'Email et le Login sont libres ; sinon la connexion est refusée (ADR-0024)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "microsoft first broker login - sans email",
      "description": "Compte Microsoft sans email : refusé avec le message standard, sans Demande d'accès (ADR-0028). Le compte Keycloak, créé juste avant, reste sans email ni lien : il ne peut pas se connecter, et un nouvel essai est refusé de même. Condition sans valeur attendue : vraie quand l'email est absent (null)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-attribute",
          "authenticatorConfig": "microsoft sans email",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorConfig": "microsoft refus sans email",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "microsoft sans email",
      "config": {
        "attribute_name": "email",
        "regex": "false",
        "not": "false",
        "include_group_attributes": "false"
      }
    },
    {
      "alias": "microsoft refus sans email",
      "config": {
        "denyErrorMessage": "invalidUserMessage"
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "displayName": "Google",
      "enabled": "$(env:GOOGLE_ENABLED)",
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "google first broker login",
      "config": {
        "clientId": "$(env:GOOGLE_CLIENT_ID)",
        "clientSecret": "$(env:GOOGLE_CLIENT_SECRET)",
        "syncMode": "IMPORT",
        "filteredByClaim": "true",
        "claimFilterName": "email_verified",
        "claimFilterValue": "true"
      }
    },
    {
      "alias": "microsoft",
      "providerId": "microsoft",
      "displayName": "Microsoft",
      "enabled": "$(env:MICROSOFT_ENABLED)",
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "microsoft first broker login",
      "config": {
        "clientId": "$(env:MICROSOFT_CLIENT_ID)",
        "clientSecret": "$(env:MICROSOFT_CLIENT_SECRET)",
        "syncMode": "IMPORT"
      }
    }
  ]
}
