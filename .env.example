# Rempli automatiquement par le script du socle :
#   socle/scripts/ajouter-application.sh <nom> <ce-dossier>
# Le fichier .env n'est jamais versionné.

APP_NAME=
PUBLIC_URL=

# Image publiée par GitHub Actions et version déployée (« local » = construite sur ce PC).
IMAGE=ghcr.io/deteemma/mesuratemporis
VERSION=local

# Base PostgreSQL du socle : compte applicatif (RLS) et compte propriétaire (migrations).
DATABASE_URL=
MIGRATIONS_DATABASE_URL=

# Keycloak du socle (realm de l'application).
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=api
# Annuaire des comptes (ADR-0018) : API d'administration du realm et compte de
# service. Vides = valeurs par défaut : adresse déduite de OIDC_JWKS_URL
# (<keycloak>/admin/realms/<realm>), compte « api-admin ».
KEYCLOAK_ADMIN_URL=
KEYCLOAK_ADMIN_CLIENT_ID=
# Secret du compte de service, généré par le script du socle qui applique le realm.
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Connexion Google / Microsoft (voir INSTALL.md). Vide = bouton désactivé.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Limites mémoire.
API_MEM_LIMIT=384m
MIGRATIONS_MEM_LIMIT=256m
